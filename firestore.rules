rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Accounts an admin set to "review" or "suspended" lose every role-based permission here,
    // not just in the app's screens.
    function isActiveAccount() {
      return isSignedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || string(userDoc().get('accountStatus', 'active')).lower() == 'active');
    }

    function userRole() {
      // Case-insensitive, and safe when the role field is missing.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isActiveAccount()
        ? string(userDoc().get('role', '')).lower()
        : null;
    }

    function isTeacherLike() {
      return userRole() in ['teacher', 'admin'];
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    // A parent may read data about the students linked to them in users/{parent}.childUids.
    function isParentOf(studentUid) {
      return userRole() == 'parent' && studentUid in userDoc().get('childUids', []);
    }

    function validRole(r) {
      return r in ['student', 'teacher', 'admin', 'parent'];
    }

    function allowedUserKeys() {
      return ['name', 'email', 'role', 'requestedRole', 'learnerStage', 'roleNote', 'photoURL', 'createdAt', 'updatedAt', 'lastLoginAt', 'accountStatus', 'adminNote', 'disabledReason', 'resolvedAt', 'issueFlag', 'studentId', 'classroomIds', 'class', 'childUids'];
    }

    function allowedStudentKeys() {
      return ['userUid', 'name', 'gradeLevel', 'classroomIds', 'primaryTeacherUid', 'status', 'currentLevel', 'xp', 'nextLevelXp', 'streak', 'mastery', 'weaknessLabel', 'weaknessScore', 'focusSkills', 'createdAt', 'updatedAt'];
    }

    function allowedClassroomKeys() {
      return ['name', 'grade', 'subject', 'teacherUid', 'teacherUids', 'studentIds', 'studentUids', 'activeStudents', 'completionRate', 'createdAt', 'updatedAt'];
    }

    function allowedSubmissionKeys() {
      return ['id', 'assignmentId', 'answers', 'classroomId', 'studentId', 'studentUid', 'assignmentTitle', 'topic', 'score', 'status', 'feedback', 'submittedAt', 'updatedAt'];
    }

    // What a student may change when re-submitting their own, not-yet-marked homework.
    function studentResubmitKeys() {
      return ['id', 'assignmentId', 'answers', 'assignmentTitle', 'topic', 'status', 'submittedAt', 'updatedAt', 'classroomId'];
    }

    // Everything a student's first hand-in may contain (no score or feedback).
    function studentSubmissionKeys() {
      return ['id', 'assignmentId', 'studentUid', 'answers', 'assignmentTitle', 'topic', 'status', 'submittedAt', 'updatedAt', 'classroomId'];
    }

    // A student may only tag a hand-in with one of their own classes.
    function classroomIdIsOwn() {
      return !('classroomId' in request.resource.data)
        || request.resource.data.classroomId in userDoc().get('classroomIds', []);
    }

    function homeworkIsPublished(assignmentId) {
      return string(get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data.get('status', '')) == 'published';
    }

    // Fields a user may set on their own profile when it is first created.
    function selfCreateKeys() {
      return ['name', 'email', 'role', 'requestedRole', 'learnerStage', 'roleNote', 'photoURL', 'createdAt', 'updatedAt', 'lastLoginAt'];
    }

    function allowedProgressKeys() {
      return ['studentId', 'userUid', 'classroomId', 'mastery', 'level', 'xp', 'nextLevelXp', 'streak', 'weaknessLabel', 'weaknessScore', 'focusAreas', 'recentQuestTitles', 'updatedAt'];
    }

    function selfProfileKeysAreSafe() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'requestedRole', 'learnerStage', 'roleNote', 'photoURL', 'updatedAt', 'lastLoginAt']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isTeacherLike() || isParentOf(userId);

      // Self-registration always starts as a student; only an admin can grant other roles.
      // (Previously a new user could create their own doc with role "admin".)
      // Only basic profile fields: no classes, status, notes or child links.
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(selfCreateKeys())
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.get('requestedRole', '') in ['', 'student', 'teacher', 'admin', 'parent'];

      allow update: if (
          isSelf(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedUserKeys())
          && request.resource.data.get('role', null) == resource.data.get('role', null)
          && request.resource.data.get('email', null) == resource.data.get('email', null)
          && (!('requestedRole' in request.resource.data) || request.resource.data.requestedRole in ['', 'student', 'teacher', 'admin', 'parent'])
          && selfProfileKeysAreSafe()
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedUserKeys())
          && (!('requestedRole' in request.resource.data) || request.resource.data.requestedRole in ['', 'student', 'teacher', 'admin', 'parent'])
          && (!('role' in request.resource.data) || validRole(request.resource.data.role))
          && (!('childUids' in request.resource.data) || request.resource.data.childUids is list)
          && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active', 'review', 'suspended'])
          && (!('issueFlag' in request.resource.data) || request.resource.data.issueFlag is bool)
        );

      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isTeacherLike() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isTeacherLike() && request.resource.data.keys().hasOnly(allowedStudentKeys());
      allow update: if isTeacherLike() && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedStudentKeys());
      allow delete: if isAdmin();
    }

    match /classrooms/{classroomId} {
      allow read: if isTeacherLike() || (isSignedIn() && request.auth.uid in resource.data.studentUids);
      allow create: if isTeacherLike() && request.resource.data.keys().hasOnly(allowedClassroomKeys());
      allow update: if isTeacherLike() && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedClassroomKeys());
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isTeacherLike() || isSelf(memberId);
        allow write: if isTeacherLike();
      }
    }

    match /submissions/{submissionId} {
      allow read: if isTeacherLike()
        || (isSignedIn() && resource.data.studentUid == request.auth.uid)
        || isParentOf(resource.data.studentUid);
      // A student may only hand in their own work, under the id "<assignmentId>_<uid>", to published
      // homework, without a score or feedback. (Before, a student could grade themselves or create
      // someone else's id first and block that student's hand-in.)
      allow create: if isTeacherLike()
        || (
          isActiveAccount()
          && request.resource.data.studentUid == request.auth.uid
          && submissionId == request.resource.data.assignmentId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(studentSubmissionKeys())
          && classroomIdIsOwn()
          && request.resource.data.status == 'submitted'
          && homeworkIsPublished(request.resource.data.assignmentId)
        );
      allow update: if (isTeacherLike() && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedSubmissionKeys()))
        || (
          isActiveAccount()
          && resource.data.studentUid == request.auth.uid
          && request.resource.data.studentUid == request.auth.uid
          && resource.data.get('status', 'submitted') == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(studentResubmitKeys())
          && classroomIdIsOwn()
        );
      allow delete: if isAdmin();
    }

    match /progressSummaries/{summaryId} {
      allow read: if isTeacherLike() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isTeacherLike() && request.resource.data.keys().hasOnly(allowedProgressKeys());
      allow update: if isTeacherLike() && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedProgressKeys());
      allow delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isTeacherLike();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacherLike();
    }

    match /aiRuns/{runId} {
      allow read: if isTeacherLike();
      allow create: if isActiveAccount();
      allow update, delete: if isTeacherLike();
    }

    // --- Homework assignments ---
    function allowedHomeworkKeys() {
      return [
        'id',
        'title',
        'description',
        'dueAt',
        'status', // draft | published | archived
        'totalPoints',
        'questions', // legacy
        'questionRefs', // Kahoot-style
        'createdBy',
        'createdAt',
        'updatedAt',
        'targetType',        // 'all' | 'class' | 'students'
        'targetClass',       // class name string
        'targetStudentUids'  // array of student uids
      ];
    }

    function homeworkStatusValid() {
      return !('status' in request.resource.data)
        || request.resource.data.status in ['draft', 'published', 'archived'];
    }

    match /homeworkAssignments/{assignmentId} {
      // Staff see everything; everyone else only published homework (the app queries status == published).
      allow read: if isTeacherLike() || (isActiveAccount() && resource.data.status == 'published');

      allow create: if isTeacherLike()
        && request.resource.data.keys().hasOnly(allowedHomeworkKeys())
        && homeworkStatusValid()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isTeacherLike()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedHomeworkKeys())
        && homeworkStatusValid()
        && (
          isAdmin()
          || resource.data.get('createdBy', null) == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // --- Answer keys: the full questions (with answers) for each homework. Staff only. ---
    // homeworkAssignments/{id} holds an answer-free copy that students may read.
    match /homeworkAnswerKeys/{assignmentId} {
      allow read: if isTeacherLike();
      allow write: if isTeacherLike()
        && (
          isAdmin()
          || !exists(/databases/$(database)/documents/homeworkAssignments/$(assignmentId))
          || get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data.get('createdBy', null) == request.auth.uid
        );
    }

    // --- Question Bank (Kahoot-style, shape aligned to UI mockDatabase) ---
    function allowedQuestionBankKeys() {
      return [
        // common
        'id',
        'type',
        'topic',
        'points',
        'timeLimitSec',
        'media',
        'tags',
        'difficulty',

        // UI-aligned content fields
        'target_level',
        'question_text',
        'options',
        'correct_answer',
        'blanks',
        'pairs',
        'ideal_answer',
        'grading_rubric',
        'max_word_count',
        'deleted',

        // backward-compatible aliases (older editor/bridge)
        'prompt',
        'choices',
        'correctChoiceIds',

        // audit
        'createdBy',
        'createdAt',
        'updatedAt',

        // legacy
        'classroomId'
      ];
    }

    match /questionBank/{questionId} {
      allow read: if isTeacherLike();

      allow create: if isTeacherLike()
        && request.resource.data.keys().hasOnly(allowedQuestionBankKeys())
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isTeacherLike()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedQuestionBankKeys())
        && (
          isAdmin()
          || resource.data.get('createdBy', null) == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // Per-user AI provider config. Only the server (Admin SDK) writes it; a browser write could
    // point someone else's stored key at a URL the writer controls.
    match /aiProviderConfigs/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow write: if false;
    }
  }
}
