rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Who is asking ─────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Accounts set to "review" or "suspended" lose every role-based permission here,
    // not just in the app's screens. (Older profiles without the field are active.)
    function isActiveAccount() {
      return isSignedIn()
        && (!hasProfile() || string(userDoc().get('accountStatus', 'active')).lower() == 'active');
    }

    function userRole() {
      // Case-insensitive, and safe when the role field is missing.
      return hasProfile() && isActiveAccount() ? string(userDoc().get('role', '')).lower() : null;
    }

    function isTeacherLike() {
      return userRole() in ['teacher', 'admin'];
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    // Runs the whole platform: creates schools and moves people between them.
    // Only the server sets this flag (for the ADMIN_EMAILS accounts).
    function isPlatformAdmin() {
      return hasProfile() && isActiveAccount() && userDoc().get('platformAdmin', false) == true;
    }

    // ── Schools ───────────────────────────────────────────────────────────────
    // Every user and every piece of school data carries a schoolId. People only see data
    // from their own school; '' (no school yet) matches nothing.
    function mySchool() {
      return hasProfile() ? string(userDoc().get('schoolId', '')) : '';
    }

    // Plain field access (not .get) so Firestore can prove it from a query's where('schoolId', '==', …).
    // A document without a schoolId fails the check. The platform admin belongs to no school but
    // may work in any of them (the app's school switcher picks which).
    function inMySchool(data) {
      return isPlatformAdmin() || (mySchool() != '' && data.schoolId == mySchool());
    }

    function schoolExists(schoolId) {
      return schoolId is string && schoolId != ''
        && exists(/databases/$(database)/documents/schools/$(schoolId));
    }

    function mySchoolSharesQuestions() {
      return get(/databases/$(database)/documents/schools/$(mySchool())).data.get('shareQuestionBank', false) == true;
    }

    // Teachers can be limited to some 班別 (users/{teacher}.teacherClasses, set by the school admin).
    // No list set = every class of the school (as before). Admins are never limited.
    function hasClassLimit() {
      return userRole() == 'teacher' && 'teacherClasses' in userDoc();
    }

    function myClasses() {
      return userDoc().get('teacherClasses', []);
    }

    // Plain field access so a query with where('class', 'in', myClasses) can be proven.
    function canSeeClassOf(data) {
      return !hasClassLimit() || data['class'] in myClasses();
    }

    // A parent may read data about the students linked to them in users/{parent}.childUids
    // (callers also require the data to be in the parent's own school).
    function isParentOf(studentUid) {
      return userRole() == 'parent' && studentUid in userDoc().get('childUids', []);
    }

    function validRole(r) {
      return r in ['student', 'teacher', 'admin', 'parent'];
    }

    // School list: names only, readable by anyone signed in (new users pick their school).
    // Created, renamed and configured only by the server.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // schoolSecrets/{schoolId} (each school's encrypted AI key) has no rule: server only.

    // ── Users ─────────────────────────────────────────────────────────────────
    // Every field a user document may hold.
    function userKeys() {
      return ['name', 'email', 'photoURL', 'role', 'schoolId', 'accountStatus', 'class', 'childUids', 'teacherClasses',
        'studentProfile', 'platformAdmin', 'createdAt', 'updatedAt', 'lastLoginAt'];
    }

    // What a school admin may change on a member of their school.
    function schoolAdminEditableKeys() {
      return ['name', 'role', 'accountStatus', 'class', 'childUids', 'teacherClasses', 'updatedAt'];
    }

    function userUpdateIsValid() {
      return (!('role' in request.resource.data) || validRole(request.resource.data.role))
        && (!('childUids' in request.resource.data) || request.resource.data.childUids is list)
        && (!('teacherClasses' in request.resource.data) || request.resource.data.teacherClasses is list)
        && (!('class' in request.resource.data) || request.resource.data['class'] is string)
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active', 'review', 'suspended']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || isPlatformAdmin()
        || (isTeacherLike() && inMySchool(resource.data) && canSeeClassOf(resource.data))
        || (isParentOf(userId) && inMySchool(resource.data));

      // Sign-up: always a student awaiting approval, optionally already choosing a school.
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'role', 'schoolId', 'accountStatus', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.accountStatus == 'review'
        && (!('schoolId' in request.resource.data) || schoolExists(request.resource.data.schoolId));

      allow update: if (
          // Anyone: their name, photo and sign-in time.
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt', 'lastLoginAt'])
        ) || (
          // While awaiting approval: choose (or change) which school to join.
          isSelf(userId)
          && resource.data.get('accountStatus', 'active') == 'review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolId', 'name', 'photoURL', 'updatedAt', 'lastLoginAt'])
          && schoolExists(request.resource.data.schoolId)
        ) || (
          // School admin: members of their own school (not the platform admin, not the school itself).
          isAdmin()
          && inMySchool(resource.data)
          && resource.data.get('platformAdmin', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(schoolAdminEditableKeys())
          && userUpdateIsValid()
        ) || (
          // Platform admin: anyone, including which school they belong to.
          isPlatformAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'schoolId', 'accountStatus', 'class', 'childUids', 'teacherClasses', 'updatedAt'])
          && (!('schoolId' in request.resource.data) || request.resource.data.schoolId == '' || schoolExists(request.resource.data.schoolId))
          // Taken out of every school: back to awaiting approval.
          && (request.resource.data.get('schoolId', '') != '' || request.resource.data.get('accountStatus', 'active') == 'review')
          && userUpdateIsValid()
        );

      allow delete: if isPlatformAdmin()
        || (isAdmin() && inMySchool(resource.data) && resource.data.get('platformAdmin', false) != true);
    }

    // ── Submissions ───────────────────────────────────────────────────────────
    // What staff may change when marking: score, feedback and status.
    function allowedSubmissionKeys() {
      return ['id', 'schoolId', 'assignmentId', 'answers', 'class', 'studentUid', 'assignmentTitle', 'topic', 'score', 'status', 'feedback', 'submittedAt', 'updatedAt'];
    }

    // What a student may change when re-submitting their own, not-yet-marked homework.
    function studentResubmitKeys() {
      return ['answers', 'assignmentTitle', 'topic', 'status', 'submittedAt', 'updatedAt', 'class'];
    }

    // Everything a student's first hand-in may contain (no score or feedback).
    function studentSubmissionKeys() {
      return ['id', 'schoolId', 'assignmentId', 'studentUid', 'answers', 'assignmentTitle', 'topic', 'status', 'submittedAt', 'updatedAt', 'class'];
    }

    // A student may only tag a hand-in with their own class.
    function classIsOwn() {
      return !('class' in request.resource.data)
        || request.resource.data['class'] == userDoc().get('class', '');
    }

    function homeworkIsPublishedInMySchool(assignmentId) {
      let hw = get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data;
      return string(hw.get('status', '')) == 'published' && inMySchool(hw);
    }

    match /submissions/{submissionId} {
      allow read: if (isTeacherLike() && inMySchool(resource.data) && canSeeClassOf(resource.data))
        || (isSignedIn() && resource.data.studentUid == request.auth.uid)
        || (isParentOf(resource.data.studentUid) && inMySchool(resource.data));
      // Only students create hand-ins: their own work, under the id "<assignmentId>_<uid>", to published
      // homework of their school, without a score or feedback.
      allow create: if (
          isActiveAccount()
          && userRole() == 'student'
          && !isPlatformAdmin()
          && inMySchool(request.resource.data)
          && request.resource.data.studentUid == request.auth.uid
          && submissionId == request.resource.data.assignmentId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(studentSubmissionKeys())
          && classIsOwn()
          && request.resource.data.status == 'submitted'
          && homeworkIsPublishedInMySchool(request.resource.data.assignmentId)
        );
      allow update: if (
          isTeacherLike()
          && inMySchool(resource.data)
          && canSeeClassOf(resource.data)
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedSubmissionKeys())
        ) || (
          isActiveAccount()
          && resource.data.studentUid == request.auth.uid
          && resource.data.get('status', 'submitted') == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentResubmitKeys())
          && classIsOwn()
          && homeworkIsPublishedInMySchool(resource.data.assignmentId)
        );
      allow delete: if isAdmin() && inMySchool(resource.data);
    }

    // ── Homework ──────────────────────────────────────────────────────────────
    function allowedHomeworkKeys() {
      return [
        'id',
        'schoolId',
        'title',
        'description',
        'dueAt',
        'status', // draft | published | archived
        'totalPoints',
        'questions', // answer-free copy
        'questionRefs',
        'createdBy',
        'createdAt',
        'updatedAt',
        'targetType',        // 'all' | 'class' | 'students'
        'targetClass',       // class name string
        'targetStudentUids'  // array of student uids
      ];
    }

    function homeworkStatusValid() {
      return !('status' in request.resource.data)
        || request.resource.data.status in ['draft', 'published', 'archived'];
    }

    match /homeworkAssignments/{assignmentId} {
      // Staff see all of their school's homework; everyone else only its published homework.
      allow read: if inMySchool(resource.data)
        && (isTeacherLike() || (isActiveAccount() && resource.data.status == 'published'));

      allow create: if isTeacherLike()
        && inMySchool(request.resource.data)
        && request.resource.data.keys().hasOnly(allowedHomeworkKeys())
        && homeworkStatusValid()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isTeacherLike()
        && inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedHomeworkKeys())
        && homeworkStatusValid()
        && (isAdmin() || resource.data.get('createdBy', null) == request.auth.uid);

      allow delete: if isAdmin() && inMySchool(resource.data);
    }

    // Answer keys: the full questions (with answers) for each homework. Staff of that school only.
    // homeworkAssignments/{id} holds an answer-free copy that students may read.
    match /homeworkAnswerKeys/{assignmentId} {
      allow read: if isTeacherLike() && inMySchool(resource.data);
      allow create: if isTeacherLike()
        && inMySchool(request.resource.data)
        && (
          !exists(/databases/$(database)/documents/homeworkAssignments/$(assignmentId))
          || (
            inMySchool(get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data)
            && (isAdmin() || get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data.get('createdBy', null) == request.auth.uid)
          )
        );
      allow update: if isTeacherLike()
        && inMySchool(resource.data)
        && inMySchool(request.resource.data)
        && (
          isAdmin()
          || get(/databases/$(database)/documents/homeworkAssignments/$(assignmentId)).data.get('createdBy', null) == request.auth.uid
        );
      allow delete: if isAdmin() && inMySchool(resource.data);
    }

    // ── Question bank ─────────────────────────────────────────────────────────
    function allowedQuestionBankKeys() {
      return [
        'id', 'schoolId', 'shared',
        'type', 'topic', 'points', 'timeLimitSec', 'media', 'tags', 'difficulty',
        'target_level', 'question_text', 'options', 'correct_answer', 'blanks', 'pairs',
        'ideal_answer', 'grading_rubric', 'max_word_count', 'deleted',
        // backward-compatible aliases (older editor/bridge)
        'prompt', 'choices', 'correctChoiceIds',
        'createdBy', 'createdAt', 'updatedAt'
      ];
    }

    match /questionBank/{questionId} {
      // Own school's questions, plus questions from schools that chose to share theirs.
      allow read: if isTeacherLike()
        && (isPlatformAdmin() || mySchool() != '')
        && (inMySchool(resource.data) || resource.data.shared == true);

      // "shared" always follows the school's setting (the server updates it when the setting changes).
      allow create: if isTeacherLike()
        && inMySchool(request.resource.data)
        && request.resource.data.keys().hasOnly(allowedQuestionBankKeys())
        && request.resource.data.createdBy == request.auth.uid
        && (isPlatformAdmin() || request.resource.data.get('shared', false) == mySchoolSharesQuestions());

      allow update: if isTeacherLike()
        && inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.get('shared', false) == resource.data.get('shared', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedQuestionBankKeys())
        && (isAdmin() || resource.data.get('createdBy', null) == request.auth.uid);

      allow delete: if isAdmin() && inMySchool(resource.data);
    }

    // Everything else (old collections such as students, classrooms, progressSummaries,
    // aiProviderConfigs, appSettings, schoolSecrets) is closed to browsers.
  }
}
