# QuestClass runtime config
# Copy to .env for local development. Do not commit real secrets.

PORT=18890

# Public Firebase Web SDK config (safe to expose to browser, but still keep managed via env)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=questclass-8462a
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# AI provider (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4.1-mini

# Admin seeding only: local path to service account JSON
# Never commit the JSON file itself.
GOOGLE_APPLICATION_CREDENTIALS=
