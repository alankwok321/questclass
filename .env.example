# QuestClass runtime config
# Copy to .env for local development. Do not commit real secrets.

PORT=18890

# Public Firebase Web SDK config (safe to expose to browser, but still keep managed via env)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=questclass-8462a
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# AI provider (optional fallback; admins normally set the key on the 「AI 設定」 page)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4.1-mini

# Server-side Firebase Admin (needed on Vercel for AI key storage and admin tools).
# Paste the whole service-account JSON as one line. Keep it secret.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google accounts that become admin when they sign in (comma-separated).
ADMIN_EMAILS=danielkwok.ai@gmail.com

# Encrypts the school AI key saved on the 「AI 設定」 page (any long random string). Required to save a key there.
AI_CONFIG_ENCRYPTION_KEY=

# Admin seeding only: local path to service account JSON
# Never commit the JSON file itself.
GOOGLE_APPLICATION_CREDENTIALS=
